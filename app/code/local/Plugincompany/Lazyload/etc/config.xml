<?xml version="1.0"?>
<config>
    <modules>
        <Plugincompany_Lazyload>
            <version>1.7.0</version>
        </Plugincompany_Lazyload>
    </modules>
    <global>
        <resources>
            <plugincompany_lazyload_setup>
                <setup>
                    <module>Plugincompany_Lazyload</module>
                    <class>Plugincompany_Lazyload_Model_Resource_Setup</class>
                </setup>
            </plugincompany_lazyload_setup>
        </resources>
        <models>
            <plugincompany_lazyload>
                <class>Plugincompany_Lazyload_Model</class>
                <resourceModel>plugincompany_lazyload_resource</resourceModel>
            </plugincompany_lazyload>
            <plugincompany_lazyload_resource>
                <class>Plugincompany_Lazyload_Model_Resource</class>
                <entities>
                    <remoteimage>
                        <table>plugincompany_lazyload_remoteimage</table>
                    </remoteimage>
                </entities>
            </plugincompany_lazyload_resource>
        </models>
        <blocks>
            <plugincompany_lazyload>
                <class>Plugincompany_Lazyload_Block</class>
            </plugincompany_lazyload>
        </blocks>
        <helpers>
            <plugincompany_lazyload>
                <class>Plugincompany_Lazyload_Helper</class>
            </plugincompany_lazyload>
        </helpers>

    </global>
    <frontend>
        <layout>
            <updates>
                <plugincompany_lazyload>
                    <file>plugincompany/lazyload.xml</file>
                </plugincompany_lazyload>
            </updates>
        </layout>
        <events>
            <core_block_abstract_to_html_after>
                <observers>
                    <plugincompany_lazyload>
                        <type>model</type>
                        <class>plugincompany_lazyload/observer</class>
                        <method>coreBlockAbstractToHtmlAfter</method>
                    </plugincompany_lazyload>
                </observers>
            </core_block_abstract_to_html_after>
        </events>
    </frontend>
    <default>
        <plugincompany_lazyload>
            <general>
                <enable>1</enable>
                <layout_handles>content,left,right,left_first,footer</layout_handles>
                <enable_product_pages>1</enable_product_pages>
                <enable_category_pages>1</enable_category_pages>
                <enable_cms_pages>1</enable_cms_pages>
                <enable_checkout_pages>0</enable_checkout_pages>
                <excluded_urls></excluded_urls>
                <placeholder_width>80</placeholder_width>
                <blur>2</blur>
                <transition>0.3</transition>
                <trigger_distance>500</trigger_distance>
                <placeholder_type>transparent</placeholder_type>
                <lookup_events>cycle-after
                    cycle-before
                    slide.bs.carousel
                    slid.bs.carousel
                </lookup_events>
                <gallery_click_event>1</gallery_click_event>
                <enable_quick_dimensions_lookup>1</enable_quick_dimensions_lookup>
                <allow_remote_images>1</allow_remote_images>
            </general>
            <iframe>
                <video>1</video>
            </iframe>
        </plugincompany_lazyload>
    </default>
</config>